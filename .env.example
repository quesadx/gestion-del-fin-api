# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<database>"
DATABASE_MIGRATION_URL="mysql://<migration_user>:<migration_password>@<host>:<port>/<database>"
SHADOW_DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<shadow_database>"

# Gemini-AI
GEMINI-API-KEY=your_hyper_secret_gemini_api_key

# JWT (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-with-at-least-32-characters-here
JWT_EXPIRY=1h

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
