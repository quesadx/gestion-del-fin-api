generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model achievements {
  id                Int                 @id @default(autoincrement())
  name              String              @unique(map: "achievements_name_unique") @db.VarChar(100)
  description       String?             @db.VarChar(255)
  icon_url          String              @db.VarChar(500)
  trigger_rule      String              @db.VarChar(100)
  user_achievements user_achievements[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admission_requests {
  id                      Int                               @id @default(autoincrement())
  camp_id                 Int
  applicant_name          String                            @db.VarChar(150)
  applicant_age           Int?
  applicant_skills        String?                           @db.Text
  health_notes            String?                           @db.Text
  background_notes        String?                           @db.Text
  photo_url               String?                           @db.VarChar(500)
  id_card_url             String?                           @db.VarChar(500)
  ai_decision             admission_requests_ai_decision    @default(PENDING)
  ai_reasoning            String?                           @db.Text
  ai_suggested_profession String?                           @db.VarChar(80)
  ai_profession_id        Int?
  person_id               Int?
  reviewed_by             Int?
  final_decision          admission_requests_final_decision @default(PENDING)
  reviewed_at             DateTime?
  created_at              DateTime                          @default(now())
  camps                   camps                             @relation(fields: [camp_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users                   users?                            @relation(fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ai_profession           professions?                      @relation(fields: [ai_profession_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person                  people?                           @relation(fields: [person_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([camp_id], map: "admission_requests_camp_id_idx")
  @@index([reviewed_by], map: "admission_requests_reviewed_by_idx")
  @@index([ai_profession_id], map: "admission_requests_ai_profession_id_idx")
  @@index([person_id], map: "admission_requests_person_id_idx")
  @@index([created_at], map: "admission_requests_created_at_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camp_transfer_items {
  id               Int                          @id @default(autoincrement())
  camp_transfer_id Int
  item_type        camp_transfer_item_item_type
  resource_type_id Int?
  person_id        Int?
  quantity         Decimal?                     @db.Decimal(10, 2)
  camp_transfers   camp_transfers               @relation(fields: [camp_transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  persons          people?                      @relation(fields: [person_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resource_type    resource_types?              @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([camp_transfer_id], map: "camp_transfer_items_camp_transfer_id_idx")
  @@index([person_id], map: "camp_transfer_items_person_id_idx")
  @@index([resource_type_id], map: "camp_transfer_items_resource_type_id_idx")
  @@map("camp_transfer_item")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camp_transfers {
  id                      Int                   @id @default(autoincrement())
  requesting_camp         Int
  target_camp             Int
  status                  camp_transfers_status @default(PENDING)
  type                    camp_transfers_type
  notes                   String?               @db.Text
  requested_by            Int
  leader_person_id        Int?
  scheduled_delivery_date DateTime?
  approved_by_source      Int?
  approved_by_target      Int?
  approved_source_at      DateTime?
  approved_target_at      DateTime?
  created_at              DateTime              @default(now())
  camp_transfer_items     camp_transfer_items[]
  approved_by_source_ref  users?                @relation("transfer_approved_by_source", fields: [approved_by_source], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approved_by_target_ref  users?                @relation("transfer_approved_by_target", fields: [approved_by_target], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requested_by_ref        users                 @relation("transfer_requested_by", fields: [requested_by], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requesting_camp_ref     camps                 @relation("transfer_requesting_camp", fields: [requesting_camp], references: [id], onDelete: Restrict, onUpdate: Cascade)
  target_camp_ref         camps                 @relation("transfer_target_camp", fields: [target_camp], references: [id], onDelete: Restrict, onUpdate: Cascade)
  leader_person_ref       people?               @relation("transfer_leader", fields: [leader_person_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([approved_by_source], map: "camp_transfers_approved_by_source_idx")
  @@index([approved_by_target], map: "camp_transfers_approved_by_target_idx")
  @@index([requested_by], map: "camp_transfers_requested_by_idx")
  @@index([requesting_camp], map: "camp_transfers_requesting_camp_idx")
  @@index([target_camp], map: "camp_transfers_target_camp_idx")
  @@index([leader_person_id], map: "camp_transfers_leader_person_id_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camps {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique(map: "camps_name_unique") @db.VarChar(100)
  location             String?              @db.VarChar(100)
  status               camps_status         @default(ACTIVE)
  ai_context_prompt    String?              @db.Text
  created_at           DateTime             @default(now())
  admission_requests   admission_requests[]
  audit_logs           audit_logs[]
  requesting_transfers camp_transfers[]     @relation("transfer_requesting_camp")
  target_transfers     camp_transfers[]     @relation("transfer_target_camp")
  expeditions          expeditions[]
  inventories          inventories[]
  inventory_logs       inventory_logs[]
  persons              people[]
  users                users[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contribution_overrides {
  id               Int       @id @default(autoincrement())
  person_id        Int
  resource_type_id Int
  reason           String    @db.VarChar(255)
  start_date       DateTime  @default(now()) @db.Date
  end_date         DateTime? @db.Date
  created_by       Int?
  amount           Decimal   @db.Decimal(8, 2)

  persons       people        @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource_type resource_types @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users         users?        @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([created_by], map: "contribution_overrides_created_by_idx")
  @@index([person_id], map: "contribution_overrides_person_id_idx")
  @@index([resource_type_id], map: "contribution_overrides_resource_type_id_idx")
}

model expedition_allocated_resources {
  expedition_id    Int
  resource_type_id Int
  amount           Decimal       @db.Decimal(12, 2)
  expeditions      expeditions   @relation(fields: [expedition_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource_type    resource_types @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([expedition_id, resource_type_id])
  @@index([resource_type_id], map: "expedition_allocated_resources_resource_type_id_idx")
}

model expedition_found_resources {
  expedition_id    Int
  resource_type_id Int
  amount           Decimal       @db.Decimal(12, 2)
  expeditions      expeditions   @relation(fields: [expedition_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource_type    resource_types @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([expedition_id, resource_type_id])
  @@index([resource_type_id], map: "expedition_found_resources_resource_type_id_idx")
}

model expedition_members {
  expedition_id Int
  person_id     Int
  expeditions   expeditions @relation(fields: [expedition_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  persons       people      @relation(fields: [person_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([person_id, expedition_id])
  @@index([expedition_id], map: "expedition_members_expedition_id_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model expeditions {
  id                             Int                              @id @default(autoincrement())
  camp_id                        Int
  destination                    String                           @db.VarChar(255)
  status                         expeditions_status               @default(PLANNED)
  created_by                     Int
  departure_date                 DateTime                         @db.Date
  expected_return_date           DateTime                         @db.Date
  actual_return_date             DateTime?                        @db.Date
  max_return_date                DateTime                         @db.Date
  notes                          String?                          @db.Text
  created_at                     DateTime                         @default(now())
  expedition_allocated_resources expedition_allocated_resources[]
  expedition_found_resources     expedition_found_resources[]
  expedition_members             expedition_members[]
  camps                          camps                            @relation(fields: [camp_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users                          users                            @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([camp_id], map: "expeditions_camp_id_idx")
  @@index([created_by], map: "expeditions_created_by_idx")
  @@index([departure_date], map: "expeditions_departure_date_idx")
  @@index([expected_return_date], map: "expeditions_expected_return_date_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model inventories {
  id               Int           @id @default(autoincrement())
  camp_id          Int
  resource_type_id Int
  quantity         Decimal       @default(0.00) @db.Decimal(12, 2)
  last_updated     DateTime      @updatedAt
  camps            camps         @relation(fields: [camp_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource_type    resource_types @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([camp_id, resource_type_id], map: "uq_camp_resource")
  @@index([resource_type_id], map: "inventories_resource_type_id_idx")
  @@map("inventory")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model inventory_logs {
  id               Int                    @id @default(autoincrement())
  camp_id          Int
  resource_type_id Int
  logged_by        Int?
  log_type         inventory_log_log_type
  quantity_change  Decimal                @db.Decimal(12, 2)
  logged_at        DateTime               @default(now())
  description      String?                @db.VarChar(255)
  camps            camps                  @relation(fields: [camp_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource_type    resource_types         @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users            users?                 @relation(fields: [logged_by], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([camp_id], map: "inventory_logs_camp_id_idx")
  @@index([logged_by], map: "inventory_logs_logged_by_idx")
  @@index([resource_type_id], map: "inventory_logs_resource_type_id_idx")
  @@index([logged_at], map: "inventory_logs_logged_at_idx")
  @@map("inventory_log")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model person_status_logs {
  id         Int            @id @default(autoincrement())
  person_id  Int
  old_status persons_status
  new_status persons_status
  reason     String?        @db.Text
  changed_by Int?
  changed_at DateTime       @default(now())
  users      users?         @relation(fields: [changed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  persons    people         @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([changed_by], map: "person_status_logs_changed_by_idx")
  @@index([person_id], map: "person_status_logs_person_id_idx")
  @@map("person_status_log")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model people {
  id                          Int                           @id @default(autoincrement())
  camp_id                     Int
  profession_id               Int
  identification_code         String?                       @unique(map: "identification_code_UNIQUE") @db.VarChar(20)
  full_name                   String                        @db.VarChar(150)
  age                         Int?
  blood_type                  String?                       @db.VarChar(5)
  skills_summary              String?                       @db.Text
  photo_url                   String?                       @db.VarChar(500)
  status                      persons_status                @default(HEALTHY)
  admitted_at                 DateTime                      @default(now())
  admission_requests          admission_requests[]
  camp_transfer_items         camp_transfer_items[]
  led_transfers               camp_transfers[]              @relation("transfer_leader")
  contribution_overrides      contribution_overrides[]
  expedition_members          expedition_members[]
  person_status_logs          person_status_logs[]
  camps                       camps                         @relation(fields: [camp_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  professions                 professions                   @relation(fields: [profession_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  profession_reassignment_logs profession_reassignment_logs[]

  @@index([camp_id], map: "people_camp_id_idx")
  @@index([profession_id], map: "people_profession_id_idx")
  @@map("persons")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model profession_reassignment_logs {
  id                 Int         @id @default(autoincrement())
  person_id          Int
  from_profession_id Int
  to_profession_id   Int
  reason             String?     @db.Text
  start_date         DateTime    @default(now()) @db.Date
  end_date           DateTime?   @db.Date
  from_profession    professions @relation("profession_log_from_profession", fields: [from_profession_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  persons            people      @relation(fields: [person_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  to_profession      professions @relation("profession_log_to_profession", fields: [to_profession_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([from_profession_id], map: "profession_reassignment_logs_from_profession_id_idx")
  @@index([person_id], map: "profession_reassignment_logs_person_id_idx")
  @@index([to_profession_id], map: "profession_reassignment_logs_to_profession_id_idx")
  @@map("profession_reassignment_log")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model professions {
  id                            Int                             @id @default(autoincrement())
  name                          String                          @unique(map: "professions_name_unique") @db.VarChar(80)
  description                   String?                         @db.Text
  admission_requests            admission_requests[]
  persons                       people[]
  from_profession_logs          profession_reassignment_logs[]  @relation("profession_log_from_profession")
  to_profession_logs            profession_reassignment_logs[]  @relation("profession_log_to_profession")
  professions_resources_amounts professions_resources_amounts[]
}

model professions_resources_amounts {
  profession_id    Int
  resource_type_id Int
  amount           Decimal       @db.Decimal(12, 2)
  professions      professions   @relation(fields: [profession_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource_type    resource_types @relation(fields: [resource_type_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([profession_id, resource_type_id])
  @@index([resource_type_id], map: "professions_resources_amounts_resource_type_id_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model resource_types {
  id                             Int                              @id @default(autoincrement())
  name                           String                           @unique(map: "resource_type_name_unique") @db.VarChar(80)
  unit                           String                           @db.VarChar(20)
  daily_ration                   Decimal                          @db.Decimal(8, 2)
  minimum_stock                  Decimal                          @db.Decimal(10, 2)
  auto_daily                     Boolean                          @default(false)
  camp_transfer_items            camp_transfer_items[]
  contribution_overrides         contribution_overrides[]
  expedition_allocated_resources expedition_allocated_resources[]
  expedition_found_resources     expedition_found_resources[]
  inventories                    inventories[]
  inventory_logs                 inventory_logs[]
  professions_resources_amounts  professions_resources_amounts[]

  @@map("resource_type")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique(map: "roles_name_unique") @db.VarChar(60)
  description      String?            @db.VarChar(255)
  users            users[]
  role_permissions role_permissions[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model permissions {
  id               Int                @id @default(autoincrement())
  name             String             @unique(map: "permissions_name_unique") @db.VarChar(80)
  description      String?            @db.VarChar(255)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([role_id, permission_id])
  @@index([permission_id], map: "role_permissions_permission_id_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model system_configs {
  id          Int      @id @default(1)
  version     String?  @db.VarChar(20)
  server_time DateTime

  @@map("system_config")
}

model user_achievements {
  id             Int          @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  earned_at      DateTime     @default(now())
  achievements   achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users          users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_id, achievement_id])
  @@index([achievement_id], map: "user_achievements_achievement_id_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                           Int                      @id @default(autoincrement())
  camp_id                      Int
  role_id                      Int
  session_version              Int                      @default(1)
  username                     String                   @unique(map: "username_UNIQUE") @db.VarChar(60)
  password_hash                String                   @db.VarChar(255)
  is_active                    Boolean                  @default(true)
  last_activity                DateTime?
  created_at                   DateTime                 @default(now())
  admission_requests           admission_requests[]
  audit_logs                   audit_logs[]
  transfers_approved_by_source camp_transfers[]         @relation("transfer_approved_by_source")
  transfers_approved_by_target camp_transfers[]         @relation("transfer_approved_by_target")
  transfers_requested_by       camp_transfers[]         @relation("transfer_requested_by")
  contribution_overrides       contribution_overrides[]
  expeditions                  expeditions[]
  inventory_logs               inventory_logs[]
  person_status_logs           person_status_logs[]
  user_achievements            user_achievements[]
  camps                        camps                    @relation(fields: [camp_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles                        roles                    @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([camp_id], map: "users_camp_id_idx")
  @@index([role_id], map: "users_role_id_idx")
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  camp_id     Int?
  action      audit_log_action
  target_type audit_log_target_type
  target_id   Int?
  metadata    Json?    @db.JsonB
  created_at  DateTime @default(now())
  users       users?   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  camps       camps?   @relation(fields: [camp_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([user_id], map: "audit_logs_user_id_idx")
  @@index([camp_id], map: "audit_logs_camp_id_idx")
  @@index([created_at], map: "audit_logs_created_at_idx")
  @@map("audit_log")
}

enum camp_transfer_item_item_type {
  RESOURCE
  PERSON
}

enum expeditions_status {
  PLANNED
  ONGOING
  RETURNED
  CANCELLED
}

enum camp_transfers_status {
  PENDING
  APPROVED_SOURCE
  APPROVED_TARGET
  COMPLETED
  REJECTED
}

enum camps_status {
  ACTIVE
  ABANDONED
}

enum camp_transfers_type {
  RESOURCE
  PERSON
  MIXED
}

enum inventory_log_log_type {
  DAILY_GAIN
  DAILY_RATION
  MANUAL_IN
  MANUAL_OUT
  EXPEDITION_OUT
  EXPEDITION_IN
  TRANSFER_OUT
  TRANSFER_IN
}

enum persons_status {
  SICK
  HEALTHY
  INJURED
  AWAY
  DEAD
}

enum admission_requests_ai_decision {
  ACCEPTED
  PENDING
  REJECTED
}

enum admission_requests_final_decision {
  ACCEPTED
  REJECTED
  PENDING
}

enum audit_log_action {
  CREATE_CAMP
  UPDATE_CAMP
  DELETE_CAMP
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  CREATE_TRANSFER
  APPROVE_TRANSFER_SOURCE
  APPROVE_TRANSFER_TARGET
  COMPLETE_TRANSFER
  REJECT_TRANSFER
  LOGIN
  LOGOUT
}

enum audit_log_target_type {
  users
  camps
  camp_transfers
}
