generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model achievements {
  id                Int                 @id @default(autoincrement())
  name              String              @unique(map: "achievements_name_unique") @db.VarChar(100)
  description       String?             @db.VarChar(255)
  icon_url          String              @db.VarChar(500)
  trigger_rule      String              @db.VarChar(100)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  deleted_at       DateTime?
  user_achievements user_achievements[]
  achievement_roles           achievement_roles[]
  achievement_notifications   achievement_notifications[]
  achievement_stats           achievement_stats?
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admission_requests {
  id                      Int                               @id @default(autoincrement())
  camp_id                 Int
  applicant_name          String                            @db.VarChar(150)
  applicant_age           Int?
  applicant_skills        String?                           @db.Text
  health_notes            String?                           @db.Text
  background_notes        String?                           @db.Text
  photo_url               String?                           @db.VarChar(500)
  id_card_url             String?                           @db.VarChar(500)
  /// AI's recommended decision (ACCEPTED/REJECTED/PENDING)
  ai_decision             admission_requests_ai_decision    @default(PENDING)
  ai_reasoning            String?                           @db.Text
  ai_confidence           Float?
  ai_suggested_profession String?                           @db.VarChar(80)
  ai_profession_id        Int?
  corrected_profession_id Int?
  correction_reason       String?                           @db.VarChar(255)
  person_id               Int?
  reviewed_by             Int?
  /// Identifies auto-admission by AI ('AI'), null otherwise
  admitted_by             String?                           @db.VarChar(10)
  /// Human reviewer's final override decision
  final_decision          admission_requests_final_decision @default(PENDING)
  reviewed_at             DateTime?
  created_at              DateTime                          @default(now())
  updated_at              DateTime                          @updatedAt
  camps                   camps                             @relation(fields: [camp_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users                   users?                            @relation(fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ai_profession           professions?                      @relation(fields: [ai_profession_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  corrected_profession    professions?                      @relation("admission_corrected_profession", fields: [corrected_profession_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person                  people?                           @relation(fields: [person_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([camp_id], map: "admission_requests_camp_id_idx")
  @@index([reviewed_by], map: "admission_requests_reviewed_by_idx")
  @@index([ai_profession_id], map: "admission_requests_ai_profession_id_idx")
  @@index([corrected_profession_id], map: "admission_requests_corrected_profession_id_idx")
  @@index([person_id], map: "admission_requests_person_id_idx")
  @@index([created_at], map: "admission_requests_created_at_idx")
}

