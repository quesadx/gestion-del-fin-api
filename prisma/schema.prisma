/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// 
/// Date-ordering constraint: departure_date <= expected_return_date <= max_return_date
/// AND actual_return_date (if set) >= departure_date.
/// Enforced at the application level via validateDateOrder() in explorations.service.ts.
/// There is no DB-level CHECK constraint; consider adding one for direct-DB access safety:
///   ALTER TABLE expeditions ADD CONSTRAINT expeditions_date_order_check
///     CHECK (
///       expected_return_date >= departure_date
///       AND max_return_date >= expected_return_date
///       AND (actual_return_date IS NULL OR actual_return_date >= departure_date)
///     );
model expeditions {
  id                             Int                              @id @default(autoincrement())
  camp_id                        Int
  destination                    String                           @db.VarChar(255)
  status                         expeditions_status               @default(PLANNED)
  created_by                     Int
  departure_date                 DateTime                         @db.Date
  expected_return_date           DateTime                         @db.Date
  actual_return_date             DateTime?                        @db.Date
  max_return_date                DateTime                         @db.Date
  notes                          String?                          @db.Text
  created_at                     DateTime                         @default(now())
  updated_at                     DateTime                         @updatedAt
  deleted_at                      DateTime?
  expedition_allocated_resources  expedition_allocated_resources[]
  expedition_found_resources      expedition_found_resources[]
  expedition_returned_resources   expedition_returned_resources[]
  expedition_members              expedition_members[]
  camps                           camps                            @relation(fields: [camp_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users                           users                            @relation(fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([camp_id], map: "expeditions_camp_id_idx")
  @@index([created_by], map: "expeditions_created_by_idx")
  @@index([departure_date], map: "expeditions_departure_date_idx")
  @@index([expected_return_date], map: "expeditions_expected_return_date_idx")
}

