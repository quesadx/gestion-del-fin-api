generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model achievements {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  name              String              @unique(map: "name_UNIQUE") @db.VarChar(100)
  description       String?             @db.VarChar(255)
  icon_url          String              @db.VarChar(500)
  trigger_rule      String              @db.VarChar(100)
  user_achievements user_achievements[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admission_requests {
  id                      Int                               @id @default(autoincrement()) @db.UnsignedInt
  camp_id                 Int                               @db.UnsignedInt
  applicant_name          String                            @db.VarChar(150)
  applicant_age           Int?                              @db.UnsignedTinyInt
  applicant_skills        String?                           @db.Text
  health_notes            String?                           @db.Text
  background_notes        String?                           @db.Text
  photo_url               String?                           @db.VarChar(255)
  id_card_url             String?                           @db.VarChar(500)
  ai_decision             admission_requests_ai_decision    @default(PENDING)
  ai_reasoning            String?                           @db.Text
  ai_suggested_profession String?                           @db.VarChar(80)
  reviewed_by             Int?                              @db.UnsignedInt
  final_decision          admission_requests_final_decision @default(PENDING)
  reviewed_at             DateTime?                         @db.DateTime(0)
  created_at              DateTime                          @default(now()) @db.DateTime(0)
  camps                   camps                             @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admission_requests_camp_id")
  users                   users?                            @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reviewed_by")

  @@index([camp_id], map: "fk_admission_request_camp_idx")
  @@index([reviewed_by], map: "fk_user_reviewd_by_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camp_transfer_item {
  id               Int                          @id @default(autoincrement()) @db.UnsignedInt
  camp_transfer_id Int                          @db.UnsignedInt
  item_type        camp_transfer_item_item_type
  resource_type_id Int?                         @db.UnsignedInt
  person_id        Int?                         @db.UnsignedInt
  quantity         Decimal?                     @db.Decimal(10, 2)
  camp_transfers   camp_transfers               @relation(fields: [camp_transfer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_transfer_id")
  persons          persons?                     @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transfer_item_person_id")
  resource_type    resource_type?               @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transfer_item_resource_type_id")

  @@index([camp_transfer_id], map: "fk_camp_transfer_id_idx")
  @@index([person_id], map: "fk_person_id_idx")
  @@index([resource_type_id], map: "fk_resource_type_id_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camp_transfers {
  id                                             Int                   @id @default(autoincrement()) @db.UnsignedInt
  requesting_camp                                Int                   @db.UnsignedInt
  target_camp                                    Int                   @db.UnsignedInt
  status                                         camp_transfers_status @default(PENDING)
  type                                           camp_transfers_type
  notes                                          String?               @db.Text
  requested_by                                   Int                   @db.UnsignedInt
  leader_person_id                               Int?                  @db.UnsignedInt
  scheduled_delivery_date                        DateTime?             @db.DateTime(0)
  approved_by_source                             Int?                  @db.UnsignedInt
  approved_by_target                             Int?                  @db.UnsignedInt
  approved_source_at                             DateTime?             @db.DateTime(0)
  approved_target_at                             DateTime?             @db.DateTime(0)
  created_at                                     DateTime              @default(now()) @db.DateTime(0)
  camp_transfer_item                             camp_transfer_item[]
  users_camp_transfers_approved_by_sourceTousers users?                @relation("camp_transfers_approved_by_sourceTousers", fields: [approved_by_source], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_approved_by_source")
  users_camp_transfers_approved_by_targetTousers users?                @relation("camp_transfers_approved_by_targetTousers", fields: [approved_by_target], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_approved_by_target")
  users_camp_transfers_requested_byTousers       users                 @relation("camp_transfers_requested_byTousers", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_requested_by")
  camps_camp_transfers_requesting_campTocamps    camps                 @relation("camp_transfers_requesting_campTocamps", fields: [requesting_camp], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_requesting_camp")
  camps_camp_transfers_target_campTocamps        camps                 @relation("camp_transfers_target_campTocamps", fields: [target_camp], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_target_camp")
  persons                                        persons?              @relation(fields: [leader_person_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transfer_leader_person")

  @@index([approved_by_source], map: "fk_approved_by_source_idx")
  @@index([approved_by_target], map: "fk_approved_by_target_idx")
  @@index([requested_by], map: "fk_requested_by_idx")
  @@index([requesting_camp], map: "fk_requesting_camp_idx")
  @@index([target_camp], map: "fk_target_camp_idx")
  @@index([leader_person_id], map: "fk_transfer_leader_person_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camps {
  id                                                   Int                  @id @default(autoincrement()) @db.UnsignedInt
  name                                                 String               @unique(map: "name_UNIQUE") @db.VarChar(100)
  location                                             String?              @db.VarChar(100)
  status                                               camps_status         @default(ACTIVE)
  created_at                                           DateTime             @default(now()) @db.DateTime(0)
  admission_requests                                   admission_requests[]
  camp_transfers_camp_transfers_requesting_campTocamps camp_transfers[]     @relation("camp_transfers_requesting_campTocamps")
  camp_transfers_camp_transfers_target_campTocamps     camp_transfers[]     @relation("camp_transfers_target_campTocamps")
  expeditions                                          expeditions[]
  inventory                                            inventory[]
  inventory_log                                        inventory_log[]
  persons                                              persons[]
  users                                                users[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contribution_overrides {
  id               Int           @id @default(autoincrement()) @db.UnsignedInt
  person_id        Int           @db.UnsignedInt
  resource_type_id Int           @db.UnsignedInt
  reason           String        @db.VarChar(255)
  start_date       DateTime      @default(now()) @db.Date
  end_date         DateTime?     @db.Date
  created_by       Int           @db.UnsignedInt
  amount           Decimal       @db.Decimal(8, 2)
  persons          persons       @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contribution_overrides_person_id")
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_contribution_overrides_resource_type_id")
  users            users         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_created_by")

  @@index([created_by], map: "fk_created_by_idx")
  @@index([person_id], map: "fk_person_id_idx")
  @@index([resource_type_id], map: "fk_resource_type__id_idx")
}

model expedition_allocated_resources {
  expedition_id    Int           @db.UnsignedInt
  resource_type_id Int           @db.UnsignedInt
  amount           Decimal       @db.Decimal(12, 2)
  expeditions      expeditions   @relation(fields: [expedition_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exp_allocated_expedition_id")
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exp_allocated_resource_type_id")

  @@id([expedition_id, resource_type_id])
  @@index([expedition_id], map: "fk_expedition_id_idx")
  @@index([resource_type_id], map: "fk_resource_type_id_idx")
}

model expedition_found_resources {
  expedition_id    Int           @db.UnsignedInt
  resource_type_id Int           @db.UnsignedInt
  amount           Decimal       @db.Decimal(12, 2)
  expeditions      expeditions   @relation(fields: [expedition_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exp_found_expedition_id")
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exp_found_resource_type_id")

  @@id([expedition_id, resource_type_id])
  @@index([expedition_id], map: "fk_expedition_id_idx")
  @@index([resource_type_id], map: "fk_resource_type_id_idx")
}

model expedition_members {
  expedition_id Int         @db.UnsignedInt
  person_id     Int         @db.UnsignedInt
  expeditions   expeditions @relation(fields: [expedition_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exp_members_expedition_id")
  persons       persons     @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exp_members_person_id")

  @@id([person_id, expedition_id])
  @@index([expedition_id], map: "fk_expedition_id_idx")
  @@index([person_id], map: "fk_person_id_idx")
