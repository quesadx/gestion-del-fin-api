/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model expeditions {
  id                             Int                              @id @default(autoincrement()) @db.UnsignedInt
  camp_id                        Int                              @db.UnsignedInt
  destination                    String                           @db.VarChar(255)
  status                         expeditions_status               @default(PLANNED)
  created_by                     Int                              @db.UnsignedInt
  departure_date                 DateTime                         @db.Date
  expected_return_date           DateTime                         @db.Date
  actual_return_date             DateTime?                        @db.Date
  max_return_date                DateTime                         @db.Date
  notes                          String?                          @db.Text
  created_at                     DateTime                         @default(now()) @db.DateTime(0)
  expedition_allocated_resources expedition_allocated_resources[]
  expedition_found_resources     expedition_found_resources[]
  expedition_members             expedition_members[]
  camps                          camps                            @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expeditions_camp_id")
  users                          users                            @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_expeditions_created_by")

  @@index([camp_id], map: "fk_camp_id_idx")
  @@index([created_by], map: "fk_created_by_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
