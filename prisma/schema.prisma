generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model achievements {
  id                Int                 @id @default(autoincrement())
  name              String              @unique(map: "achievements_name_unique") @db.VarChar(100)
  description       String?             @db.VarChar(255)
  icon_url          String              @db.VarChar(500)
  trigger_rule      String              @db.VarChar(100)
  user_achievements user_achievements[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admission_requests {
  id                      Int                               @id @default(autoincrement())
  camp_id                 Int
  applicant_name          String                            @db.VarChar(150)
  applicant_age           Int?
  applicant_skills        String?                           @db.Text
  health_notes            String?                           @db.Text
  background_notes        String?                           @db.Text
  photo_url               String?                           @db.VarChar(255)
  id_card_url             String?                           @db.VarChar(500)
  ai_decision             admission_requests_ai_decision    @default(PENDING)
  ai_reasoning            String?                           @db.Text
  ai_suggested_profession String?                           @db.VarChar(80)
  ai_profession_id        Int?
  reviewed_by             Int?
  final_decision          admission_requests_final_decision @default(PENDING)
  reviewed_at             DateTime?
  created_at              DateTime                          @default(now())
  camps                   camps                             @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                   users?                            @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([camp_id])
  @@index([reviewed_by])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camp_transfer_item {
  id               Int                          @id @default(autoincrement())
  camp_transfer_id Int
  item_type        camp_transfer_item_item_type
  resource_type_id Int?
  person_id        Int?
  quantity         Decimal?                     @db.Decimal(10, 2)
  camp_transfers   camp_transfers               @relation(fields: [camp_transfer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons          persons?                     @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource_type    resource_type?               @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([camp_transfer_id])
  @@index([person_id])
  @@index([resource_type_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camp_transfers {
  id                                             Int                   @id @default(autoincrement())
  requesting_camp                                Int
  target_camp                                    Int
  status                                         camp_transfers_status @default(PENDING)
  type                                           camp_transfers_type
  notes                                          String?               @db.Text
  requested_by                                   Int
  leader_person_id                               Int?
  scheduled_delivery_date                        DateTime?
  approved_by_source                             Int?
  approved_by_target                             Int?
  approved_source_at                             DateTime?
  approved_target_at                             DateTime?
  created_at                                     DateTime              @default(now())
  camp_transfer_item                             camp_transfer_item[]
  users_camp_transfers_approved_by_sourceTousers users?                @relation("camp_transfers_approved_by_sourceTousers", fields: [approved_by_source], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_camp_transfers_approved_by_targetTousers users?                @relation("camp_transfers_approved_by_targetTousers", fields: [approved_by_target], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_camp_transfers_requested_byTousers       users                 @relation("camp_transfers_requested_byTousers", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  camps_camp_transfers_requesting_campTocamps    camps                 @relation("camp_transfers_requesting_campTocamps", fields: [requesting_camp], references: [id], onDelete: NoAction, onUpdate: NoAction)
  camps_camp_transfers_target_campTocamps        camps                 @relation("camp_transfers_target_campTocamps", fields: [target_camp], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons                                        persons?              @relation(fields: [leader_person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approved_by_source])
  @@index([approved_by_target])
  @@index([requested_by])
  @@index([requesting_camp])
  @@index([target_camp])
  @@index([leader_person_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model camps {
  id                                                   Int                  @id @default(autoincrement())
  name                                                 String               @unique(map: "camps_name_unique") @db.VarChar(100)
  location                                             String?              @db.VarChar(100)
  status                                               camps_status         @default(ACTIVE)
  ai_context_prompt                                    String?              @db.Text
  created_at                                           DateTime             @default(now())
  admission_requests                                   admission_requests[]
  audit_log                                            audit_log[]
  camp_transfers_camp_transfers_requesting_campTocamps camp_transfers[]     @relation("camp_transfers_requesting_campTocamps")
  camp_transfers_camp_transfers_target_campTocamps     camp_transfers[]     @relation("camp_transfers_target_campTocamps")
  expeditions                                          expeditions[]
  inventory                                            inventory[]
  inventory_log                                        inventory_log[]
  persons                                              persons[]
  users                                                users[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model contribution_overrides {
  id               Int           @id @default(autoincrement())
  person_id        Int
  resource_type_id Int
  reason           String        @db.VarChar(255)
  start_date       DateTime      @default(now()) @db.Date
  end_date         DateTime?     @db.Date
  created_by       Int
  amount           Decimal       @db.Decimal(8, 2)
  persons          persons       @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_by])
  @@index([person_id])
  @@index([resource_type_id])
}

model expedition_allocated_resources {
  expedition_id    Int
  resource_type_id Int
  amount           Decimal       @db.Decimal(12, 2)
  expeditions      expeditions   @relation(fields: [expedition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([expedition_id, resource_type_id])
  @@index([expedition_id])
  @@index([resource_type_id])
}

model expedition_found_resources {
  expedition_id    Int
  resource_type_id Int
  amount           Decimal       @db.Decimal(12, 2)
  expeditions      expeditions   @relation(fields: [expedition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([expedition_id, resource_type_id])
  @@index([expedition_id])
  @@index([resource_type_id])
}

model expedition_members {
  expedition_id Int
  person_id     Int
  expeditions   expeditions @relation(fields: [expedition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons       persons     @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([person_id, expedition_id])
  @@index([expedition_id])
  @@index([person_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model expeditions {
  id                             Int                              @id @default(autoincrement())
  camp_id                        Int
  destination                    String                           @db.VarChar(255)
  status                         expeditions_status               @default(PLANNED)
  created_by                     Int
  departure_date                 DateTime                         @db.Date
  expected_return_date           DateTime                         @db.Date
  actual_return_date             DateTime?                        @db.Date
  max_return_date                DateTime                         @db.Date
  notes                          String?                          @db.Text
  created_at                     DateTime                         @default(now())
  expedition_allocated_resources expedition_allocated_resources[]
  expedition_found_resources     expedition_found_resources[]
  expedition_members             expedition_members[]
  camps                          camps                            @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                          users                            @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([camp_id])
  @@index([created_by])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model inventory {
  id               Int           @id @default(autoincrement())
  camp_id          Int
  resource_type_id Int
  quantity         Decimal       @default(0.00) @db.Decimal(12, 2)
  last_updated     DateTime      @default(now())
  camps            camps         @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([camp_id, resource_type_id], map: "uq_camp_resource")
  @@index([camp_id])
  @@index([resource_type_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model inventory_log {
  id               Int                    @id @default(autoincrement())
  camp_id          Int
  resource_type_id Int
  logged_by        Int?
  log_type         inventory_log_log_type
  delta            Decimal                @db.Decimal(12, 2)
  logged_at        DateTime               @default(now())
  description      String?                @db.VarChar(255)
  camps            camps                  @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource_type    resource_type          @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users?                 @relation(fields: [logged_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([camp_id])
  @@index([logged_by])
  @@index([resource_type_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model person_status_log {
  id         Int      @id @default(autoincrement())
  person_id  Int
  old_status String   @db.VarChar(20)
  new_status String   @db.VarChar(45)
  reason     String?  @db.Text
  changed_by Int
  changed_at DateTime @default(now())
  users      users    @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons    persons  @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([changed_by])
  @@index([person_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model persons {
  id                          Int                           @id @default(autoincrement())
  camp_id                     Int
  profession_id               Int
  identification_code         String?                       @unique(map: "identification_code_UNIQUE") @db.VarChar(20)
  full_name                   String                        @db.VarChar(150)
  age                         Int?
  blood_type                  String?                       @db.VarChar(5)
  skills_summary              String?                       @db.Text
  photo_url                   String?                       @db.VarChar(500)
  status                      persons_status                @default(HEALTHY)
  admitted_at                 DateTime                      @default(now())
  camp_transfer_item          camp_transfer_item[]
  camp_transfers              camp_transfers[]
  contribution_overrides      contribution_overrides[]
  expedition_members          expedition_members[]
  person_status_log           person_status_log[]
  camps                       camps                         @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  professions                 professions                   @relation(fields: [profession_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profession_reassignment_log profession_reassignment_log[]

  @@index([camp_id])
  @@index([profession_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model profession_reassignment_log {
  id                                                                      Int         @id @default(autoincrement())
  person_id                                                               Int
  from_profession_id                                                      Int
  to_profession_id                                                        Int
  reason                                                                  String?     @db.Text
  start_date                                                              DateTime    @default(now()) @db.Date
  end_date                                                                DateTime?   @db.Date
  professions_profession_reassignment_log_from_profession_idToprofessions professions @relation("profession_reassignment_log_from_profession_idToprofessions", fields: [from_profession_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persons                                                                 persons     @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  professions_profession_reassignment_log_to_profession_idToprofessions   professions @relation("profession_reassignment_log_to_profession_idToprofessions", fields: [to_profession_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([from_profession_id])
  @@index([person_id])
  @@index([to_profession_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model professions {
  id                                                                                      Int                             @id @default(autoincrement())
  name                                                                                    String                          @unique(map: "professions_name_unique") @db.VarChar(80)
  description                                                                             String?                         @db.Text
  persons                                                                                 persons[]
  profession_reassignment_log_profession_reassignment_log_from_profession_idToprofessions profession_reassignment_log[]   @relation("profession_reassignment_log_from_profession_idToprofessions")
  profession_reassignment_log_profession_reassignment_log_to_profession_idToprofessions   profession_reassignment_log[]   @relation("profession_reassignment_log_to_profession_idToprofessions")
  professions_resources_amounts                                                           professions_resources_amounts[]
}

model professions_resources_amounts {
  professions_id   Int
  resource_type_id Int
  amount           Decimal       @db.Decimal(12, 2)
  professions      professions   @relation(fields: [professions_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource_type    resource_type @relation(fields: [resource_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([professions_id, resource_type_id])
  @@index([professions_id])
  @@index([resource_type_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model resource_type {
  id                             Int                              @id @default(autoincrement())
  name                           String                           @unique(map: "resource_type_name_unique") @db.VarChar(80)
  unit                           String                           @db.VarChar(20)
  daily_ration                   Decimal                          @db.Decimal(8, 2)
  minimum_stock                  Decimal                          @db.Decimal(10, 2)
  auto_daily                     Boolean                          @default(false)
  camp_transfer_item             camp_transfer_item[]
  contribution_overrides         contribution_overrides[]
  expedition_allocated_resources expedition_allocated_resources[]
  expedition_found_resources     expedition_found_resources[]
  inventory                      inventory[]
  inventory_log                  inventory_log[]
  professions_resources_amounts  professions_resources_amounts[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model roles {
  id          Int     @id @default(autoincrement())
  name        String  @unique(map: "roles_name_unique") @db.VarChar(60)
  description String? @db.VarChar(255)
  users       users[]
  role_permissions role_permissions[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model permissions {
  id          Int     @id @default(autoincrement())
  name        String  @unique(map: "permissions_name_unique") @db.VarChar(80)
  description String? @db.VarChar(255)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([role_id, permission_id])
  @@index([permission_id])
  @@index([role_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model system_config {
  id          Int      @id @default(1)
  version     String?  @db.VarChar(20)
  server_time DateTime
}

model user_achievements {
  id             Int          @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  earned_at      DateTime     @default(now())
  achievements   achievements @relation(fields: [achievement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([achievement_id])
  @@index([user_id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                                                      Int                      @id @default(autoincrement())
  camp_id                                                 Int
  role_id                                                 Int
  session_version                                         Int                      @default(1)
  username                                                String                   @unique(map: "username_UNIQUE") @db.VarChar(60)
  password_hash                                           String                   @db.VarChar(255)
  is_active                                               Boolean                  @default(true)
  last_activity                                           DateTime?
  created_at                                              DateTime                 @default(now())
  admission_requests                                      admission_requests[]
  audit_log                                               audit_log[]
  camp_transfers_camp_transfers_approved_by_sourceTousers camp_transfers[]         @relation("camp_transfers_approved_by_sourceTousers")
  camp_transfers_camp_transfers_approved_by_targetTousers camp_transfers[]         @relation("camp_transfers_approved_by_targetTousers")
  camp_transfers_camp_transfers_requested_byTousers       camp_transfers[]         @relation("camp_transfers_requested_byTousers")
  contribution_overrides                                  contribution_overrides[]
  expeditions                                             expeditions[]
  inventory_log                                           inventory_log[]
  person_status_log                                       person_status_log[]
  user_achievements                                       user_achievements[]
  camps                                                   camps                    @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles                                                   roles                    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([camp_id])
  @@index([role_id])
}

model audit_log {
  id          Int      @id @default(autoincrement())
  user_id     Int
  camp_id     Int
  action      String   @db.VarChar(100)
  target_type String   @db.VarChar(80)
  target_id   Int?
  metadata    Json?    @db.JsonB
  created_at  DateTime @default(now())
  users       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  camps       camps    @relation(fields: [camp_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([camp_id])
  @@index([created_at])
}

enum camp_transfer_item_item_type {
  RESOURCE
  PERSON
}

enum expeditions_status {
  PLANNED
  ONGOING
  RETURNED
  CANCELLED
}

enum camp_transfers_status {
  PENDING
  APPROVED_SOURCE
  APPROVED_TARGET
  COMPLETED
  REJECTED
}

enum camps_status {
  ACTIVE
  ABANDONED
}

enum camp_transfers_type {
  RESOURCE
  PERSON
  MIXED
}

enum inventory_log_log_type {
  DAILY_GAIN
  DAILY_RATION
  MANUAL_IN
  MANUAL_OUT
  EXPEDITION_OUT
  EXPEDITION_IN
  TRANSFER_OUT
  TRANSFER_IN
}

enum persons_status {
  SICK
  HEALTHY
  INJURED
  AWAY
  DEAD
}

enum admission_requests_ai_decision {
  ACCEPTED
  PENDING
  REJECTED
}

enum admission_requests_final_decision {
  ACCEPTED
  REJECTED
  PENDING
}
