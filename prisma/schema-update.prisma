// Actualización del Schema Prisma para sistema de Achievements
// Ubicación: prisma/schema.prisma - AGREGAR estas líneas

// ============================================================
// MODELOS NUEVOS A AGREGAR
// ============================================================

model achievement_roles {
  achievement_id Int
  role_id        Int
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now())
  
  achievements   achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roles          roles        @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([achievement_id, role_id])
  @@index([role_id], map: "achievement_roles_role_id_idx")
  @@map("achievement_role")
}

model achievement_notifications {
  id             Int       @id @default(autoincrement())
  user_id        Int
  achievement_id Int
  notification_sent Boolean @default(false)
  sent_at        DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  achievements   achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_id, achievement_id, created_at], map: "uq_achievement_notification")
  @@index([notification_sent], map: "achievement_notifications_unsent_idx")
  @@index([user_id], map: "achievement_notifications_user_id_idx")
  @@map("achievement_notification")
}

model achievement_stats {
  id              Int       @id @default(autoincrement())
  achievement_id  Int       @unique(map: "uq_achievement_stats")
  total_unlocks   Int       @default(0)
  unlock_rate     Decimal   @default(0.00) @db.Decimal(5, 2)
  average_unlock_days Int   @default(0)
  last_unlock_at  DateTime?
  updated_at      DateTime  @updatedAt

  achievements    achievements @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("achievement_stat")
}

