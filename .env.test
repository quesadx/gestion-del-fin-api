# Test Database (separate from development)
DATABASE_URL=postgresql://gestion_user:admin@localhost:5432/gestion_del_fin_test

# JWT — dedicated test secret, never use production key
JWT_SECRET=test-jwt-secret-at-least-32-characters-long-for-e2e
JWT_EXPIRY=24h

# Server
NODE_ENV=test
PORT=3000
CORS_ORIGIN=*

# Logging — suppress Winston noise during tests
LOG_LEVEL=error

# AI — test-mode mock keys (not real credentials)
GROQ_API_KEY=sk-test-mock-key
ML_SERVICE_URL=http://localhost:8000
